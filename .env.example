# Copiar como .env.local (Vite lo carga automáticamente) y ajustar.

# Si se deja vacío o no existe, el prototipo valida los acertijos localmente.
# Con una URL, el hook crea/retoma una partida y valida contra el backend.
VITE_API_URL=http://localhost:3001/api

# Contrato de ids:
#   frontend -> el backend usa los mismos ids que src/data (recomendado).
#   compat   -> usa los ids provisionales de la rama feature/backend.
VITE_API_IDS=frontend
