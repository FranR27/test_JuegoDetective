# Copiar este archivo como .env y ajustar los valores. El archivo .env NO se sube a GitHub.

PORT=3001

# Orígenes del frontend permitidos por CORS, separados por comas
# (5173 es el puerto por defecto de Vite). En producción agregar la URL del frontend publicado.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Dónde se guardan las partidas:
#   memory    -> en memoria, sin Firebase (se pierden al reiniciar). Ideal para desarrollar.
#   firestore -> Firebase Firestore (requiere credenciales, ver abajo)
STORAGE=memory

# --- Solo si STORAGE=firestore: usar UNA de estas dos opciones ---

# Opción A (local): ruta al archivo JSON de la cuenta de servicio.
# Guardarlo en backend/credenciales/ (carpeta ignorada por git).
# GOOGLE_APPLICATION_CREDENTIALS=./credenciales/firebase-admin.json

# Opción B (Render u otro hosting): el contenido completo del JSON en una sola línea.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Nombre de la colección de Firestore (opcional)
# FIRESTORE_COLLECTION=partidas
